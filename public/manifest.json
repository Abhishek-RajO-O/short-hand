{
  "manifest_version": 3,
  "name": "ShortHand",
  "version": "1.0.0",
  "description": "Quick text expansion for support workflows.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open ShortHand"
  },
  "permissions": [
    "storage"
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"]
    }
  ]
}